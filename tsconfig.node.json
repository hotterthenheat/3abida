{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "server", "scripts/feed-check.ts", "scripts/feed-proof.ts", "scripts/field-backfill-proof.ts", "scripts/field-agree.ts", "scripts/feed-backfill.ts"]
}
