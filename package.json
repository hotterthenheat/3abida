    "@types/d3-geo": "^2.0.7",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-simple-maps": "^3.0.6",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "codemirror": "^6.0.2",
    "d3-geo": "^2.0.2",
