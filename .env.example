# Copy to .env at the repo root (git-ignored) and fill in. Never commit .env, and never prefix these with VITE_:
# a VITE_ variable is written into the browser bundle. The dev server reads them (vite.config.ts) and adds them
# to the vendor calls itself — see docs/data-feed.md. Restart `npm run dev` after a change; `npm run feed:check`
# says whether they work.

# Unusual Whales, API Basic — sent as "Authorization: Bearer …"
UW_API_TOKEN=

# Massive (Polygon), Basic — sent as the apiKey parameter
MASSIVE_API_KEY=

# Massive flat files (S3) — a later step; nothing reads these yet. The endpoint is https://files.massive.com and the
# bucket flatfiles.
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=
MASSIVE_S3_BUCKET=
