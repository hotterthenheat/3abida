# Map tiles — GENERATED, and far past GitHub's 100MB file ceiling
# (nyc.pmtiles is ~128MB). Rebuild rather than store:
#   pmtiles extract https://build.protomaps.com/<date>.pmtiles \
#     public/tiles/nyc.pmtiles --bbox=-74.35,40.45,-73.55,41.00 --maxzoom=15
# Production serves these from a host/CDN, not the repo.
public/tiles/
